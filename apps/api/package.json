{
  "name": "@dentalai/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts --api-only",
    "dev:full": "tsx src/server.ts --with-vite",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "auth:bootstrap-owner": "tsx src/domains/access/bootstrap-owner.ts",
    "dev:seed": "tsx src/development/seed-cli.ts",
    "dev:configure": "tsx src/development/configure-cli.ts",
    "subscription:admin": "tsx src/domains/administration/administrative-provider-cli.ts",
    "imaging:reconcile": "tsx src/domains/imaging/reconcile-cli.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "start": "node dist/server.js --production"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@dentalai/contracts": "0.0.0",
    "@dentalai/database": "0.0.0",
    "@dentalai/domain": "0.0.0",
    "better-auth": "1.7.7",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.3",
    "express": "4.22.3",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "nodemailer": "10.0.15",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.11",
    "@types/supertest": "7.2.1",
    "fast-check": "4.10.2",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
