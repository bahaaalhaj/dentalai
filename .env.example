# Public browser configuration. Copy this file to .env and fill in local values.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Experimental clinical modules remain disabled unless BOTH the environment and
# the individual feature flag are explicitly set. Never enable for patient care.
VITE_CLINICAL_ENV=
VITE_ENABLE_XRAY_ANALYSIS=
VITE_ENABLE_ANESTHETIC_DECISION_SUPPORT=
